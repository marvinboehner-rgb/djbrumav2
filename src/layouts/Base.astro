---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import AdsConsent from '../components/AdsConsent.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Pfad für canonical/OG, z. B. "/hochzeits-dj/bremen". Default: aktueller Pfad. */
  path?: string;
  ogImage?: string;
  jsonLd?: unknown[];
}

const { title, description, path, ogImage = '/images/og.jpg', jsonLd = [] } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, site.domain).href.replace(/\/$/, '') || site.domain;
const ogImageAbs = new URL(ogImage, site.domain).href;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <!-- Reveal-Animationen nur mit JS aktivieren (ohne JS bleibt alles sichtbar) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_DE" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts: Fraunces (Display) + Hanken Grotesk (Body), selbst gehostet (kein Google-CDN,
         DSGVO-konform & schneller; deckt sich mit §8 der Datenschutzerklärung) -->
    <link rel="stylesheet" href="/fonts/fonts.css" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

  </head>
  <body>
    <a href="#hauptinhalt" class="sr-only">Zum Inhalt springen</a>
    <Header />
    <main id="hauptinhalt">
      <slot />
    </main>
    <Footer />
    <WhatsappFab />
    <AdsConsent />

    <script>
      // Reveal-on-scroll, mit Fallback, falls IntersectionObserver fehlt
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
        // Sicherheitsnetz: nach 4s alles einblenden, egal was passiert
        setTimeout(() => els.forEach((el) => el.classList.add('is-in')), 4000);
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

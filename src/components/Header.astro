---
import { site, whatsappUrl } from '../data/site';
---
<header class="site-header" id="top">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — Startseite`}>
      <span class="brand__mark gold-text">DJ Bruma</span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__cta">
      <a class="btn btn--gold" href="/#anfrage">Termin sichern</a>
    </div>

    <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" hidden>
    {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="btn btn--gold btn--lg" href="/#anfrage">Termin sichern</a>
    <a class="btn btn--wa btn--lg" href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line-soft);
  }
  .site-header__inner { display: flex; align-items: center; gap: 1.5rem; height: 68px; }
  .brand__mark { font-family: var(--ff-display); font-size: 1.5rem; font-weight: 600; }
  .nav { display: flex; gap: 1.4rem; margin-inline: auto; font-size: .95rem; }
  .nav a { color: var(--muted); transition: color .2s; }
  .nav a:hover { color: var(--gold-soft); }
  .site-header__cta { display: flex; }
  .nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; }
  .nav-toggle span { width: 24px; height: 2px; background: var(--text); border-radius: 2px; transition: .25s; }
  .mobile-nav { display: none; flex-direction: column; gap: .6rem; padding: 1rem var(--pad) 1.5rem; border-bottom: 1px solid var(--line-soft); }
  .mobile-nav a:not(.btn) { padding: .6rem 0; color: var(--muted); border-bottom: 1px solid var(--line-soft); }

  @media (max-width: 860px) {
    .nav, .site-header__cta { display: none; }
    .nav-toggle { display: flex; margin-inline: auto 0; }
    .mobile-nav[data-open] { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.querySelector('.mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.hasAttribute('data-open');
    if (open) { menu?.removeAttribute('data-open'); menu?.setAttribute('hidden', ''); }
    else { menu?.setAttribute('data-open', ''); menu?.removeAttribute('hidden'); }
    toggle.setAttribute('aria-expanded', String(!open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => { menu.removeAttribute('data-open'); menu.setAttribute('hidden', ''); })
  );
</script>

---
import { testimonials } from '../../data/content';
import { site } from '../../data/site';
import Icon from '../Icon.astro';
---
<section class="section testi-band" id="referenzen">
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">Referenzen</p>
      <h2>Stimmen, die für sich <span class="gold-text">sprechen.</span></h2>
    </div>

    <div class="grid grid-3 testi-grid">
      {testimonials.map((t) => (
        <figure class="card testi reveal">
          <div class="stars" aria-label={`${t.rating} von 5 Sternen`}>
            {Array.from({ length: t.rating }).map(() => <Icon name="star" size={16} />)}
          </div>
          <blockquote>„{t.text}"</blockquote>
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.event}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="testi-google center reveal">
      <a class="btn btn--ghost" href={site.googleProfile} target="_blank" rel="noopener">
        Alle Bewertungen auf Google ansehen <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .testi-band { background: var(--bg-2); border-block: 1px solid var(--line-soft); }
  .testi-grid { margin-top: clamp(32px, 5vw, 56px); }
  .testi { display: flex; flex-direction: column; }
  .testi .stars { color: var(--gold); margin-bottom: .8rem; }
  .testi .stars :global(svg) { fill: var(--gold); }
  .testi blockquote { margin: 0 0 1.2rem; font-size: 1.05rem; line-height: 1.6; flex: 1; }
  .testi figcaption { display: flex; flex-direction: column; border-top: 1px solid var(--line-soft); padding-top: .9rem; }
  .testi figcaption span { color: var(--muted); font-size: .9rem; }
  .testi-google { margin-top: clamp(24px, 3vw, 36px); }
</style>

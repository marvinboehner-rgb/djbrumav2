---
import { playlists } from '../../data/playlists';
import { setPhases } from '../../data/content';
import Icon from '../Icon.astro';

// Phasen-Chips über den Karten: gefüllte Phasen gold, offene gedimmt mit "folgt".
// Macht aus "da fehlt was" ein "da kommt was", solange nur Peak gefüllt ist.
const filled = new Set(playlists.map((p) => p.phase));
const chips = setPhases.map((s) => ({ phase: s.phase, done: filled.has(s.phase) }));
---
<section class="section playlists" id="musik">
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">Musik</p>
      <h2>Hört rein, wie ein Abend bei mir <span class="gold-text">klingt.</span></h2>
      <p class="lead center">
        Keine zusammengeschnittenen Mixe, sondern die Listen, aus denen ich wirklich spiele.
        Getrennt nach Phasen, damit ihr seht: Zum Sektempfang läuft etwas völlig anderes
        als um halb eins.
      </p>
    </div>

    <div class="pl-phases reveal" role="list" aria-label="Set-Phasen">
      {chips.map((c) => (
        <span class={`pl-chip${c.done ? ' pl-chip--done' : ''}`} role="listitem">
          {c.phase}{!c.done && <small> · folgt</small>}
        </span>
      ))}
    </div>

    <div class="pl-grid">
      {playlists.map((p) => (
        <article class="pl card reveal">
          <header class="pl__head">
            <span class="pl__phase">{p.phase}</span>
            <h3>{p.title}</h3>
            <p class="pl__label">{p.label}</p>
          </header>

          <p class="pl__desc">{p.description}</p>

          <!-- Klick zum Laden: vorher geht kein Request an Spotify (§ 25 TDDDG) -->
          <button class="pl__player" data-spotify={p.spotifyId} aria-label={`Playlist "${p.title}" bei Spotify laden und anhören`}>
            <span class="pl__play"><Icon name="play" size={30} /></span>
            <span class="pl__hint">Playlist anhören<small>Spotify wird erst beim Klick geladen</small></span>
          </button>
        </article>
      ))}
    </div>

    <p class="pl__note center">
      Eure Musik plant ihr nicht allein: Wunschlieder und No-Gos gehen wir vorab gemeinsam durch.
      Was auf eurer Verbotsliste steht, läuft nicht, egal wer danach fragt.
    </p>
  </div>
</section>

<style>
  .playlists { background: var(--bg-2); }
  .pl-phases {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem;
    margin-top: clamp(24px, 3vw, 36px);
  }
  .pl-chip {
    font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
    padding: .4rem .95rem; border-radius: 999px;
    color: var(--muted-2); border: 1px solid var(--line-soft);
  }
  .pl-chip small { font-size: .68rem; letter-spacing: .08em; text-transform: none; }
  .pl-chip--done { color: #1a1208; background: var(--gold-grad); border-color: transparent; }
  .pl-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 420px));
    justify-content: center; gap: clamp(18px, 2.5vw, 28px);
    margin: clamp(28px, 4vw, 48px) 0 clamp(20px, 3vw, 32px);
  }
  .pl { display: flex; flex-direction: column; gap: 1rem; padding: clamp(18px, 2.5vw, 26px); }
  .pl__phase {
    display: inline-block; font-family: var(--ff-display); font-size: .74rem; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase; color: #1a1208;
    background: var(--gold-grad); border-radius: 999px; padding: .22rem .7rem;
  }
  .pl__head h3 { margin: .6rem 0 0; }
  .pl__label { color: var(--muted-2); font-size: .86rem; margin: .2rem 0 0; }
  .pl__desc { color: var(--muted); font-size: .95rem; margin: 0; flex: 1; }

  .pl__player {
    position: relative; width: 100%; border: 1px solid var(--line);
    border-radius: var(--r); background: var(--surface-2); color: var(--text);
    display: flex; align-items: center; gap: .9rem; text-align: left;
    padding: .9rem 1.1rem; cursor: pointer; font: inherit;
    transition: border-color .2s, background .2s;
  }
  .pl__player:hover { border-color: var(--gold); background: var(--surface); }
  .pl__play { color: var(--gold); display: grid; place-items: center; flex: none; }
  .pl__hint { display: grid; gap: .1rem; font-size: .93rem; font-weight: 600; }
  .pl__hint small { font-weight: 400; font-size: .77rem; color: var(--muted-2); }

  .pl__note { color: var(--muted-2); font-size: .92rem; max-width: 62ch; margin-inline: auto; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.pl__player').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-spotify');
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.title = 'Spotify-Playlist';
      frame.src = `https://open.spotify.com/embed/playlist/${id}`;
      frame.allow = 'clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      frame.loading = 'lazy';
      frame.style.cssText = 'width:100%;height:352px;border:0;border-radius:12px';
      btn.replaceWith(frame);
    }, { once: true });
  });
</script>

---
import { site, whatsappUrl, ratingLabel } from '../../data/site';
import Icon from '../Icon.astro';
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero.jpg';
---
<section class="hero">
  <!-- LCP-Bild: eager + fetchpriority high (behebt LCP-Finding aus dem Audit) -->
  <Image class="hero__bg" src={heroImage} alt="" widths={[480, 768, 1024, 1440, 1920]} sizes="100vw" format="avif" quality={70} loading="eager" fetchpriority="high" aria-hidden="true" />
  <div class="hero__scrim"></div>

  <div class="wrap hero__inner">
    <p class="eyebrow reveal hero__eyebrow">
      <span class="eq" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
      {site.tagline}
    </p>
    <h1 class="hero__title reveal">
      Für eine <em class="hero__em gold-text">unvergessliche</em><br />Party.
    </h1>
    <p class="hero__sub lead reveal">
      Euer Hochzeits-DJ für Bremen, Frankfurt & das Rhein-Main-Gebiet — volle Tanzfläche,
      feines Gespür für den Moment und transparente Festpreise.
      Auch für Geburtstage & Firmenfeiern.
    </p>

    <div class="hero__cta reveal">
      <a class="btn btn--gold btn--lg" href="/#anfrage">Verfügbarkeit prüfen <Icon name="arrow" size={18} /></a>
      <a class="btn btn--ghost btn--lg" href={whatsappUrl()} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> WhatsApp
      </a>
    </div>

    <a class="hero__trust reveal" href={site.googleProfile} target="_blank" rel="noopener">
      <div class="stars" aria-label={`${site.rating.value} von 5 Sternen`}>
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} />)}
      </div>
      <span><strong>{ratingLabel()}</strong> bei Google — Bewertungen ansehen</span>
    </a>
  </div>

  <a href="/#leistungen" class="hero__scroll" aria-label="Weiter">↓</a>
</section>

<style>
  .hero { position: relative; min-height: min(92vh, 820px); display: flex; align-items: center; isolation: isolate; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(120% 80% at 20% 20%, rgba(12,10,8,.35), transparent 60%),
      linear-gradient(180deg, rgba(12,10,8,.55) 0%, rgba(12,10,8,.55) 40%, rgba(12,10,8,.94) 100%);
  }
  .hero__inner { padding-block: clamp(80px, 12vh, 140px); }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: .7rem; }
  .hero__title { font-size: clamp(2.8rem, 8vw, 5.4rem); margin-bottom: 1.2rem; }
  .hero__em { font-style: italic; font-weight: 500; }
  /* Orchestrierter Aufbau: Zeilen erscheinen nacheinander */
  .hero__inner > .reveal:nth-child(2) { transition-delay: .08s; }
  .hero__inner > .reveal:nth-child(3) { transition-delay: .16s; }
  .hero__inner > .reveal:nth-child(4) { transition-delay: .24s; }
  .hero__inner > .reveal:nth-child(5) { transition-delay: .32s; }
  .hero__sub { color: var(--text); opacity: .92; max-width: 54ch; font-size: 1.18rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2rem; }
  .hero__trust { display: inline-flex; align-items: center; gap: .7rem; margin-top: 2rem; color: var(--muted); font-size: .96rem; transition: color .2s; }
  .hero__trust:hover { color: var(--gold-soft); }
  .hero__trust strong { color: var(--text); }
  .stars { display: inline-flex; color: var(--gold); }
  .stars :global(svg) { fill: var(--gold); }
  .hero__scroll { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); color: var(--muted); font-size: 1.4rem; padding: 12px 16px; animation: bob 2s ease-in-out infinite; }
  @keyframes bob { 0%,100% { transform: translate(-50%,0); } 50% { transform: translate(-50%,8px); } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll { animation: none; } }
</style>

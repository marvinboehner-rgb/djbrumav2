---
import { faqs } from '../../data/content';
---
<section class="section" id="faq">
  <div class="wrap faq-wrap">
    <div class="center">
      <p class="eyebrow">Häufige Fragen</p>
      <h2>Gut zu <span class="gold-text">wissen.</span></h2>
    </div>

    <div class="faq-list">
      {faqs.map((f, i) => (
        <details class="faq reveal" name="faq" open={i === 0}>
          <summary>{f.q}<span class="faq__icon" aria-hidden="true">+</span></summary>
          <div class="faq__body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-wrap { max-width: 820px; }
  .faq-list { margin-top: clamp(28px, 4vw, 44px); display: grid; gap: .8rem; }
  .faq { background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--r); overflow: hidden; }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; cursor: pointer; padding: 1.1rem 1.3rem; font-family: var(--ff-display); font-size: 1.12rem; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq__icon { color: var(--gold); font-size: 1.4rem; transition: transform .25s; flex: none; }
  .faq[open] .faq__icon { transform: rotate(45deg); }
  .faq__body { padding: 0 1.3rem 1.2rem; color: var(--muted); }
  .faq__body p { margin: 0; }
</style>

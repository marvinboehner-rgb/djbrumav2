---
import { cities } from '../../data/cities';
import Icon from '../Icon.astro';

const destinations = cities.filter((c) => c.destination);
---
<section class="section--tight dest-band" id="destinations">
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">Destination Weddings</p>
      <h2>Eure Hochzeit, euer <span class="gold-text">Lieblingsort.</span></h2>
      <p class="lead center">
        Ihr heiratet nicht um die Ecke? Ich begleite eure Hochzeit auch in der Toskana, auf Mallorca
        und am Bodensee — mit Planung auf Deutsch und transparenter Reisepauschale.
      </p>
    </div>

    <div class="dest-grid">
      {destinations.map((d) => (
        <a class="dest reveal" href={`/hochzeits-dj/${d.slug}`}>
          <span class="dest__region">{d.region}</span>
          <strong>Hochzeits-DJ {d.inCity}</strong>
          <span class="dest__cta">Mehr erfahren <Icon name="arrow" size={16} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .dest-band { background: var(--bg-2); border-block: 1px solid var(--line-soft); }
  .dest-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(14px, 2vw, 24px); margin-top: clamp(24px, 3vw, 40px); }
  .dest {
    display: flex; flex-direction: column; gap: .3rem;
    padding: clamp(18px, 2.5vw, 28px);
    background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--r-lg);
    transition: border-color .2s, transform .2s;
  }
  .dest:hover { border-color: var(--gold); transform: translateY(-2px); }
  .dest__region { color: var(--muted); font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; }
  .dest strong { font-family: var(--ff-display); font-size: 1.35rem; font-weight: 600; }
  .dest__cta { display: inline-flex; align-items: center; gap: .4rem; color: var(--gold); font-size: .92rem; margin-top: .6rem; }
  @media (max-width: 760px) { .dest-grid { grid-template-columns: 1fr; } }
</style>

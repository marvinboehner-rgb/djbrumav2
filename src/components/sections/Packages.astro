---
import { packages, packagesInclude, addons, priceNotes } from '../../data/content';
import Icon from '../Icon.astro';
import { Image } from 'astro:assets';
---
<section class="section" id="preise">
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">Pakete & Preise</p>
      <h2>Was es kostet, <span class="gold-text">steht hier.</span></h2>
      <p class="lead center">Drei Pakete für Hochzeit, private Feier und Firmenevent. Feste Startpreise statt "Preis auf Anfrage", den finalen Festpreis bekommst du nach dem kostenlosen Vorgespräch.</p>
    </div>

    <div class="grid grid-3 pkg-grid">
      {packages.map((p) => (
        <article class={`card pkg reveal${p.highlighted ? ' pkg--hot' : ''}`}>
          {p.highlighted && <span class="pkg__flag">Beliebteste Wahl</span>}
          <Image class="pkg__img" src={p.image} alt="" widths={[320, 480, 720]} sizes="(max-width: 760px) 100vw, 33vw" format="webp" quality={76} loading="lazy" />
          <span class="pkg__audience">{p.audience}</span>
          <h3>{p.name}</h3>
          <div class="pkg__price gold-text">{p.price}</div>
          <p class="pkg__tag">{p.tagline}</p>
          <ul class="pkg__features">
            {p.features.map((f) => <li><Icon name="check" size={16} /> {f}</li>)}
          </ul>
          <!-- Konkrete Technik: kein Verkaufsargument fuer Brautpaare, aber der Beleg
               fuer alle, die nachfragen (Locations, Techniker, Vergleichsangebote). -->
          <details class="pkg__tech">
            <summary>Welche Technik steckt drin?</summary>
            <ul>{p.tech.map((t) => <li>{t}</li>)}</ul>
          </details>
          <a class={`btn ${p.highlighted ? 'btn--gold' : 'btn--ghost'}`} href={`/?paket=${p.id}#anfrage`} data-paket={p.id}>Dieses Paket anfragen</a>
        </article>
      ))}
    </div>

    <p class="pkg__include reveal">
      <strong>In allen Paketen enthalten:</strong> {packagesInclude.join(' · ')}
    </p>

    <!-- Preis-Klarheit: beantwortet Anfahrt/Verlängerung/MwSt vor der Anfrage -->
    <div class="pricenotes reveal">
      <h3>Was drin ist und was extra kommt</h3>
      <dl class="pricenotes__list">
        {priceNotes.map((n) => (
          <div class="pricenote">
            <dt>{n.label}</dt>
            <dd>{n.text}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="addons">
      <h3 class="center">Zusatzoptionen zu den Paketen</h3>
      <div class="grid grid-4 addon-grid">
        {addons.map((a) => (
          <article class="addon reveal">
            <Image class="addon__img" src={a.image} alt="" widths={[240, 360, 520]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 25vw" format="webp" quality={74} loading="lazy" />
            <div class="addon__body">
              <div class="addon__head">
                <h4>{a.name}</h4>
                <span class="addon__price">{a.price}</span>
              </div>
              <p>{a.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* align-items: stretch (Default) statt start: sonst sind die Karten unterschiedlich
     hoch, weil sie verschieden viele Features haben, und die Buttons stehen versetzt.
     Zusammen mit flex:1 auf .pkg__features sitzt der Button jetzt überall unten. */
  .pkg-grid { margin-top: clamp(32px, 5vw, 56px); }
  .pkg { position: relative; display: flex; flex-direction: column; }
  .pkg--hot { border-color: var(--gold); box-shadow: 0 20px 50px -24px rgba(201,163,90,.5); }
  .pkg__flag { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--gold-grad); color: #1a1208; font-size: .74rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .35rem .9rem; border-radius: 100px; }
  .pkg__img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: var(--r); margin-bottom: 1.1rem; }
  /* Zielgruppe zuerst: die Frage "welches Paket ist meins" soll die Karte sofort beantworten */
  .pkg__audience { font-size: .72rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--gold); margin-bottom: .2rem; }
  .pkg__price { font-family: var(--ff-display); font-size: 1.9rem; font-weight: 600; }
  .pkg__tag { color: var(--muted); margin: .2rem 0 1rem; }
  .pkg__features { list-style: none; padding: 0; margin: 0 0 1.4rem; display: grid; gap: .6rem; flex: 1; }
  .pkg__features li { display: flex; align-items: center; gap: .55rem; font-size: .96rem; }
  .pkg__features :global(svg) { color: var(--gold); flex: none; }
  .pkg__tech { margin: 0 0 1.2rem; border-top: 1px solid var(--line-soft); padding-top: .9rem; }
  .pkg__tech summary { cursor: pointer; font-size: .85rem; color: var(--muted); list-style: none; display: flex; align-items: center; gap: .4rem; }
  .pkg__tech summary::-webkit-details-marker { display: none; }
  .pkg__tech summary::before { content: '+'; color: var(--gold); font-weight: 700; }
  .pkg__tech[open] summary::before { content: '–'; }
  .pkg__tech summary:hover { color: var(--text); }
  .pkg__tech ul { list-style: none; padding: 0; margin: .7rem 0 0; display: grid; gap: .4rem; font-size: .85rem; color: var(--muted-2); }
  .pkg__include { margin-top: clamp(24px, 3vw, 36px); text-align: center; color: var(--muted); font-size: .93rem; }
  .pkg__include strong { color: var(--text); }
  .pricenotes { margin-top: clamp(32px, 4vw, 48px); padding: clamp(20px, 3vw, 32px); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .pricenotes h3 { margin-bottom: 1.2rem; }
  .pricenotes__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem 2rem; margin: 0; }
  .pricenote dt { color: var(--gold); font-weight: 700; font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; margin-bottom: .35rem; }
  .pricenote dd { margin: 0; color: var(--muted); font-size: .96rem; }
  @media (max-width: 700px) { .pricenotes__list { grid-template-columns: 1fr; } }

  .addons { margin-top: clamp(48px, 6vw, 72px); }
  .addon-grid { margin-top: 1.6rem; }
  .addon { background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--r); overflow: hidden; }
  .addon__img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .addon__body { padding: 1rem 1.1rem 1.2rem; }
  .addon__head { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; }
  .addon__price { color: var(--gold); font-weight: 700; font-size: .85rem; white-space: nowrap; }
  .addon__body h4 { font-family: var(--ff-body); font-weight: 700; margin-bottom: .3rem; }
  .addon__body p { color: var(--muted); font-size: .9rem; margin: 0; }
</style>

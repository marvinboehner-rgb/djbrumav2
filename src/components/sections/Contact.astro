---
import { site, whatsappUrl } from '../../data/site';
import { packages } from '../../data/content';
import Icon from '../Icon.astro';

interface Props {
  /** Stadt-Kontext (Location-Pages): füllt das Ort-Feld vor, z. B. "Bremen" */
  city?: string;
  /** Präpositional-Form für die Überschrift, z. B. "in Bremen", "in der Toskana" (Default: "in <city>") */
  cityIn?: string;
}
const { city, cityIn } = Astro.props;
const headingIn = cityIn ?? (city ? `in ${city}` : '');

const steps = [
  { n: '1', t: 'Anfrage schicken', d: 'Datum & Eckdaten über das Formular oder WhatsApp, dauert 2 Minuten.' },
  { n: '2', t: 'Kostenloses Vorgespräch', d: 'Ich melde mich in 1–2 Tagen. Wir klären Ablauf, Musik & Wünsche per Video-Call.' },
  { n: '3', t: 'Festpreis & Termin sichern', d: 'Du bekommst dein transparentes Angebot. Erst dann entscheidest du, ganz unverbindlich.' },
];
---
<section class="section anfrage" id="anfrage">
  <div class="wrap anfrage__grid">
    <div class="anfrage__intro">
      <p class="eyebrow">Unverbindliche Anfrage</p>
      <h2>Ist euer Termin{headingIn ? ` ${headingIn}` : ''} noch <span class="gold-text">frei?</span></h2>
      <p class="lead">Nenn mir euer Datum, ich prüfe die Verfügbarkeit und melde mich innerhalb von 1–2 Tagen mit einer ehrlichen Antwort.</p>

      <ol class="steps">
        {steps.map((s) => (
          <li class="reveal">
            <span class="steps__n">{s.n}</span>
            <div><strong>{s.t}</strong><p>{s.d}</p></div>
          </li>
        ))}
      </ol>

      <div class="anfrage__direct">
        <a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Direkt per WhatsApp</a>
        <a class="btn btn--ghost" href={`tel:${site.contact.phoneIntl}`}><Icon name="phone" size={18} /> {site.contact.phone}</a>
      </div>
    </div>

    <!-- Netlify Forms: kein Backend nötig, Einsendungen landen im Netlify-Dashboard -->
    <form class="card anfrage__form reveal" name="anfrage" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/danke">
      <input type="hidden" name="form-name" value="anfrage" />
      <input type="hidden" name="seite" value={city ? `Stadtseite ${city}` : 'Startseite'} />
      <p hidden><label>Nicht ausfüllen: <input name="bot-field" /></label></p>

      <div class="field">
        <label for="name">Euer Name <span class="req" aria-hidden="true">*</span></label>
        <input id="name" name="name" type="text" required autocomplete="name" placeholder="Max & Mia" />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="email">E-Mail <span class="req" aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="ihr@beispiel.de" />
        </div>
        <div class="field">
          <label for="phone">Telefon (optional)</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="0151 …" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="date">Event-Datum <span class="req" aria-hidden="true">*</span></label>
          <input id="date" name="date" type="date" required />
        </div>
        <div class="field">
          <label for="type">Art des Events</label>
          <select id="type" name="type">
            <option>Hochzeit</option>
            <option>Geburtstag</option>
            <option>Firmenfeier</option>
            <option>Sonstiges</option>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="city">Ort / Location <span class="req" aria-hidden="true">*</span></label>
          <input id="city" name="city" type="text" required value={city ?? ''} placeholder="z. B. Bremen, Meierei am Bürgerpark" />
        </div>
        <div class="field">
          <label for="guests">Gästezahl (ca.)</label>
          <select id="guests" name="guests">
            <option value="">Noch offen</option>
            <option>bis 50</option>
            <option>50–100</option>
            <option>100–150</option>
            <option>über 150</option>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="paket">Wunsch-Paket</label>
          <select id="paket" name="paket">
            <option value="">Noch unentschieden</option>
            {packages.map((p) => <option value={p.id}>{p.name} ({p.price})</option>)}
          </select>
        </div>
        <div class="field">
          <label for="quelle">Wie habt ihr mich gefunden?</label>
          <select id="quelle" name="quelle">
            <option value="">Bitte wählen</option>
            <option>Google</option>
            <option>Instagram</option>
            <option>Empfehlung</option>
            <option>Location / Dienstleister</option>
            <option>Sonstiges</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="message">Worum geht's? (optional)</label>
        <textarea id="message" name="message" rows="3" placeholder="Erzählt mir kurz von eurer Feier …"></textarea>
      </div>
      <button class="btn btn--gold btn--lg" type="submit">Verfügbarkeit prüfen <Icon name="arrow" size={18} /></button>
      <p class="anfrage__note">Kein Spam, keine Weitergabe eurer Daten. Versprochen.</p>
    </form>
  </div>
</section>

<style>
  .anfrage { background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
  .anfrage__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .steps { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1.2rem; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .steps__n { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-family: var(--ff-display); font-weight: 600; color: #1a1208; background: var(--gold-grad); flex: none; }
  .steps strong { display: block; }
  .steps p { color: var(--muted); margin: .2rem 0 0; font-size: .95rem; }
  .anfrage__direct { display: flex; flex-wrap: wrap; gap: .8rem; }
  .anfrage__form { display: grid; gap: 1rem; }
  .field { display: grid; gap: .4rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { font-size: .88rem; color: var(--muted); font-weight: 600; }
  input, select, textarea { width: 100%; background: var(--bg); border: 1px solid var(--line-soft); border-radius: 10px; padding: .8rem .9rem; color: var(--text); font: inherit; font-size: .98rem; transition: border-color .2s; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); }
  textarea { resize: vertical; }
  .anfrage__note { color: var(--muted-2); font-size: .85rem; text-align: center; margin: 0; }
  @media (max-width: 820px) { .anfrage__grid { grid-template-columns: 1fr; } }
  @media (max-width: 460px) { .field-row { grid-template-columns: 1fr; } }
</style>

<script>
  // Paket-Vorauswahl: "Dieses Paket anfragen"-Buttons setzen ?paket=<id>
  const paketParam = new URLSearchParams(location.search).get('paket');
  if (paketParam) {
    const sel = document.getElementById('paket') as HTMLSelectElement | null;
    if (sel) sel.value = paketParam;
  }
  // Klicks auf Paket-CTAs derselben Seite (ohne Reload) übernehmen
  document.querySelectorAll('a[data-paket]').forEach((a) => {
    a.addEventListener('click', () => {
      const sel = document.getElementById('paket') as HTMLSelectElement | null;
      const id = a.getAttribute('data-paket');
      if (sel && id) sel.value = id;
    });
  });
</script>

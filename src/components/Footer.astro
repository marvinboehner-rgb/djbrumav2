---
import { site, whatsappUrl } from '../data/site';
import { cities } from '../data/cities';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <span class="brand__mark gold-text">DJ Bruma</span>
        <p class="footer-tag">{site.tagline}</p>
        <div class="footer-social">
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={22} /></a>
          <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube"><Icon name="youtube" size={22} /></a>
        </div>
      </div>

      <div>
        <h4 class="footer-h">Städte</h4>
        <ul class="footer-list">
          {cities.map((c) => <li><a href={`/hochzeits-dj/${c.slug}`}>Hochzeits-DJ {c.name}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="footer-h">Menü</h4>
        <ul class="footer-list">
          {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="footer-h">Kontakt</h4>
        <ul class="footer-list">
          <li><a href={`tel:${site.contact.phoneIntl}`}>{site.contact.phone}</a></li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li><a href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp schreiben</a></li>
        </ul>
      </div>
    </div>

    <hr class="divider" />
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name} · {site.legalName}</span>
      <span class="footer-legal"><a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--bg-2); border-top: 1px solid var(--line-soft); padding-block: clamp(48px, 6vw, 72px) 32px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 2rem; }
  .footer-tag { color: var(--muted); margin-top: .6rem; max-width: 28ch; }
  .footer-social { display: flex; gap: .8rem; margin-top: 1rem; color: var(--gold); }
  .footer-h { font-family: var(--ff-body); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); margin-bottom: 1rem; }
  .footer-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .footer-list a { color: var(--muted); transition: color .2s; }
  .footer-list a:hover { color: var(--gold-soft); }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-top: 24px; color: var(--muted-2); font-size: .9rem; }
  .footer-legal a:hover { color: var(--gold-soft); }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 460px) { .footer-grid { grid-template-columns: 1fr; } }
</style>

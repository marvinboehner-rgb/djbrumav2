---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../data/site';
---
<Base title="Danke für deine Anfrage – DJ Bruma" description="Deine Anfrage ist bei DJ Bruma eingegangen." path="/danke" noindex>
  <section class="section center danke">
    <div class="wrap">
      <div class="danke__badge"><Icon name="check" size={40} /></div>
      <h1>Danke, <span class="gold-text">deine Anfrage ist da!</span></h1>
      <p class="lead center">Ich melde mich innerhalb von 1–2 Tagen bei dir. Wenn's schneller gehen soll, schreib mir direkt.</p>
      <div class="danke__cta">
        <a class="btn btn--wa btn--lg" href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp schreiben</a>
        <a class="btn btn--ghost btn--lg" href="/">Zurück zur Startseite</a>
      </div>
      <p class="danke__contact">Oder ruf an: <a href={`tel:${site.contact.phoneIntl}`}>{site.contact.phone}</a></p>
    </div>
  </section>
</Base>

<style>
  /* Die Seite hatte keinerlei eigene Styles: Badge und Buttons standen nackt untereinander */
  .danke { min-height: 70vh; display: grid; place-items: center; }
  .danke__badge {
    width: 84px; height: 84px; margin: 0 auto 1.6rem; border-radius: 50%;
    display: grid; place-items: center; color: #1a1208; background: var(--gold-grad);
    box-shadow: 0 20px 50px -18px rgba(201, 163, 90, .6);
  }
  /* Der Haken springt rein: aus dem Absenden wird ein kleiner Moment, kein harter Cut */
  @media (prefers-reduced-motion: no-preference) {
    .danke__badge { animation: dankePop .5s cubic-bezier(.34, 1.56, .64, 1) both; }
  }
  @keyframes dankePop {
    from { transform: scale(.6); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }
  .danke__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: .9rem; margin-top: 2rem; }
  .danke__contact { margin-top: 1.6rem; color: var(--muted); }
  .danke__contact a { color: var(--gold-soft); border-bottom: 1px solid var(--line); }
</style>

